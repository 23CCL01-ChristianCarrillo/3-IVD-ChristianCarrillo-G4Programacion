Algoritmo videojuego
	Definir monedas, totales Como Entero
    monedas <- 0
Mientras monedas < 350 Hacer
	Escribir "Tienes ",monedas," monedas, consigue 350 monedas para desbloquear el nivel 5"
	Escribir "Cuantás monedas conseguiste?"
	Leer totales
	monedas <- monedas + totales
    FinMientras
    Escribir "Nivel 5 desbloqueado"
FinAlgoritmo